Options -Indexes
ErrorDocument 404 /404.html

<IfModule deflate_module>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

<IfModule headers_module>
    <FilesMatch "\.(js|css|jpg|jpeg|png|svg|woff|woff2)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule rewrite_module>
    RewriteEngine On

    # ✅ Archivos y carpetas reales
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ✅ Sitemap / robots
    RewriteRule ^sitemap\.xml$ - [L]
    RewriteRule ^robots\.txt$ - [L]

    # ✅ API
    RewriteRule ^api/v1/?$ api.php [L]
    RewriteRule ^api/v1/(.*)$ api.php/$1 [L]

    # ✅ Angular vendedores (SPA)
    RewriteRule (/.*)?$ /public/pages/sellers/app/dist/browser/index.html [L]

    # ✅ Backend PHP (fallback)
    RewriteRule ^ index.php [L]
</IfModule>